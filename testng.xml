<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Test Suite" verbose="2">

    <listeners>
        <!-- RetryTransformer: IAnnotationTransformer — must be listed before runtime listeners -->
        <listener class-name="com.nidhinsai.api.utils.RetryTransformer"/>
        <listener class-name="com.nidhinsai.api.listeners.ApiTestListener"/>
    </listeners>

    <test name="Auth Tests">
        <groups>
            <run>
                <include name="auth"/>
            </run>
        </groups>
        <classes>
            <class name="com.nidhinsai.api.tests.AuthApiTest"/>
        </classes>
    </test>

    <test name="Users API Tests">
        <groups>
            <run>
                <include name="users"/>
            </run>
        </groups>
        <classes>
            <class name="com.nidhinsai.api.tests.UsersApiTest"/>
        </classes>
    </test>

</suite>
